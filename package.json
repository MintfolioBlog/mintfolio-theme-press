{
  "name": "@mintfolio/theme-press",
  "version": "0.4.1",
  "description": "Press: an independent magazine theme for Mintfolio, with bold type and quiet reading.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "theme.mjs",
    "settings.ts",
    "pages",
    "layouts",
    "components",
    "styles",
    "utils",
    "config",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets"
  ],
  "exports": {
    "./theme": "./theme.mjs",
    "./settings": "./settings.ts",
    "./config": "./config/theme-press.config.mjs"
  },
  "mintfolio": {
    "configTemplate": "./config/theme-press.config.mjs"
  },
  "peerDependencies": {
    "@mintfolio/core": "^0.4.1",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@mintfolio/core": "^0.4.1",
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "check": "astro check",
    "prepack": "npm run check",
    "deps:update": "node tools/update-local-deps.mjs"
  },
  "license": "GPL-3.0-only",
  "author": "Mintfolio contributors",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MintfolioBlog/mintfolio-theme-press.git"
  },
  "homepage": "https://github.com/MintfolioBlog/mintfolio-theme-press#readme",
  "bugs": {
    "url": "https://github.com/MintfolioBlog/mintfolio-theme-press/issues"
  }
}
