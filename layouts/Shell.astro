---
import faviconUrl from '../assets/favicon.svg?url';
import type { BasePageData } from '@mintfolio/core/astro';
import type { ThemeContext } from '@mintfolio/core/theme';
import SeoHead from '@mintfolio/core/components/SeoHead.astro';
import type { PressSettings } from '../settings';
import { mastheadUnits, navigationKey } from '../utils/display';
import '../styles/press.css';
interface Props { theme: ThemeContext<PressSettings>; page: BasePageData; }
const { theme, page } = Astro.props;
const home = page.kind === 'home';
const total = (await theme.content.posts({ limit: 0 })).total;
const masthead = theme.settings.masthead.trim() || theme.site.title;
const mastheadStyle = `--masthead-units: ${mastheadUnits(masthead).toFixed(2)};`;
const footerNote = theme.site.description || theme.site.profile.bio;
const routeKey = (url: string) => navigationKey(url, theme.site.url);
const current = (url: string) => routeKey(url) === routeKey(page.url) || (routeKey(url) === routeKey(theme.urls.archive()) && ['post', 'archive'].includes(page.kind));
---
<!doctype html>
<html lang={theme.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.settings.paperColor} />
    <SeoHead seo={page.seo} faviconFallback={faviconUrl} />
  </head>
  <body class:list={['press-site', { 'press-site--home': home }]} style={`--accent: ${theme.settings.accentColor}; --paper: ${theme.settings.paperColor};`}>
    <a class="skip-link" href="#main">跳至正文</a>
    <div class="site-frame">
      <header class="site-header">
        <div class="imprint-bar">
          <a class="site-name" href={theme.urls.home()}>{theme.site.title}</a>
          <a class="imprint-feed" href={theme.urls.rss()}>RSS 订阅 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="masthead-row">
          <a href={theme.urls.home()} class="masthead" style={mastheadStyle} aria-label={theme.site.title + ' 首页'}>{masthead}</a>
          {home && <span class="masthead-mark" aria-hidden="true">✳</span>}
        </div>
        <nav class="site-nav" aria-label="主导航">
          <div class="site-nav__links">{theme.navigation.map(link => <a href={link.url} aria-current={current(link.url) ? 'page' : undefined}>{link.label}</a>)}</div>
          <a class="site-nav__search" href={theme.urls.archive() + '#search'}><span aria-hidden="true">⌕</span> 搜索</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div class="footer-main">
          <a class="footer-statement" href={theme.urls.home()}>{theme.site.title}</a>
          <div class="footer-side">{footerNote && <p>{footerNote}</p>}<a href={theme.urls.archive()}>全部文章 <span class="mono">{total}</span></a><a href={theme.urls.rss()}>RSS 订阅 <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="footer-fineprint"><span>© {new Date().getFullYear()} {theme.site.profile.name || theme.site.title}</span><span>Mintfolio <span aria-hidden="true">/</span> Press</span>{theme.site.icp && <a href="https://beian.miit.gov.cn/">{theme.site.icp}</a>}<a href="#main">回到页首 ↑</a></div>
      </footer>
    </div>
  </body>
</html>
