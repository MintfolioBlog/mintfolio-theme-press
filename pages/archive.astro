---
import type { ArchivePageData, PageProps } from '@mintfolio/core/astro';
import Pagination from '@mintfolio/core/components/Pagination.astro';
import SearchPanel from '@mintfolio/core/components/SearchPanel.astro';
import type { PressSettings } from '../settings';
import Shell from '../layouts/Shell.astro';
import PostRow from '../components/PostRow.astro';
type Props = PageProps<PressSettings, ArchivePageData>;
const { theme, page } = Astro.props;
const tags = (await theme.taxonomy.tags()).slice(0, 12);
const categories = await theme.taxonomy.categories();
const total = page.pagination?.totalItems ?? page.posts.length;
const offset = ((page.pagination?.current ?? 1) - 1) * (page.pagination?.pageSize ?? page.posts.length);
const kindLabel = { tag: '标签', category: '分类', series: '系列' } as const;
---
<Shell theme={theme} page={page}>
  <header class="page-heading archive-heading">
    <div>{page.taxonomy && <p class="eyebrow">{kindLabel[page.taxonomy.kind]}</p>}<h1>{page.taxonomy?.label || '全部文章'}</h1></div>
    <div class="archive-count"><b>{String(total).padStart(2, '0')}</b><span>篇文章{page.pagination && page.pagination.totalPages > 1 ? ` · ${page.pagination.current} / ${page.pagination.totalPages} 页` : ''}</span></div>
  </header>
  <section id="search" class="search-board" aria-labelledby="search-title">
    <h2 id="search-title">搜索</h2>
    <SearchPanel placeholder="标题、摘要或正文" />
  </section>
  <nav class="archive-topics" aria-label="分类">
    <a href={theme.urls.archive()} aria-current={!page.taxonomy ? 'page' : undefined}>全部</a>
    {categories.map(category => <a href={category.url} aria-current={page.taxonomy?.kind === 'category' && page.taxonomy.label === category.label ? 'page' : undefined}>{category.label}<sup>{category.count}</sup></a>)}
  </nav>
  <div class="archive-layout">
    <section class="archive-posts" aria-label="文章列表">
      {page.posts.length > 0 ? page.posts.map((post, index) => <PostRow post={post} index={offset + index + 1} language={theme.site.language} timezone={theme.site.blog?.timezone} />) : <p class="empty-note">这一页还没有文章。</p>}
      {page.pagination && <Pagination pagination={page.pagination} />}
    </section>
    <aside class="archive-margin" aria-label="标签"><p class="eyebrow">标签</p>{tags.length > 0 && <div class="tag-cloud">{tags.map(tag => <a href={tag.url} aria-current={page.taxonomy?.kind === 'tag' && page.taxonomy.label === tag.label ? 'page' : undefined}>#{tag.label}</a>)}</div>}<a class="text-link" href={theme.urls.rss()}>RSS 订阅 ↗</a></aside>
  </div>
</Shell>
