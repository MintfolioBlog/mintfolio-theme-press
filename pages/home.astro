---
import type { HomePageData, PageProps } from '@mintfolio/core/astro';
import type { PressSettings } from '../settings';
import Shell from '../layouts/Shell.astro';
import Geometry from '../components/Geometry.astro';
import PostRow from '../components/PostRow.astro';
import { imageSrc } from '../utils/display';
type Props = PageProps<PressSettings, HomePageData>;
const { theme, page } = Astro.props;
const posts = page.posts.slice(0, theme.settings.homePostCount);
const featured = posts[0];
const cover = imageSrc(featured?.cover);
const tags = (await theme.taxonomy.tags()).slice(0, 8);
const headline = theme.settings.heroHeadline.trim() || theme.site.title;
const subtitle = theme.settings.heroSubtitle.trim() || theme.site.description || theme.site.profile.bio;
const avatar = imageSrc(theme.site.profile.avatar);
---
<Shell theme={theme} page={page}>
  <section class="home-lead">
    <div class="home-lead__copy">
      <p class="eyebrow"><span class="tiny-square" aria-hidden="true"></span> 个人观察 / FIELD NOTES</p>
      <h1 class="hero-title">{headline.split('\n').map(line => <span>{line}</span>)}</h1>
      {subtitle && <p class="hero-intro">{subtitle}</p>}
      <a class="ink-button" href={theme.urls.archive()}>翻阅所有文章 <span aria-hidden="true">↗</span></a>
      <div class="lead-colophon"><span>文字与日常之间。</span><span class="mono">{String(page.posts.length).padStart(3, '0')} ENTRIES</span></div>
    </div>
    <div class="cover-story">
      <div class="cover-story__top"><span>{featured?.pinned ? '置顶阅读' : '从这篇开始'}</span><span class="mono">01 / SELECTED</span></div>
      {featured ? (
        <a href={featured.url} class="cover-story__link" aria-label={'阅读：' + featured.title}>
          <div class="cover-story__art">{cover ? <img src={cover} alt="" width="640" height="660" fetchpriority="high" /> : theme.settings.showGeometry ? <Geometry /> : <span class="cover-monogram" aria-hidden="true">Aa.</span>}</div>
          <div class="cover-story__caption"><h2>{featured.title}</h2><span aria-hidden="true">↗</span></div>
        </a>
      ) : (
        <><div class="cover-story__art">{theme.settings.showGeometry ? <Geometry /> : <span class="cover-monogram" aria-hidden="true">Aa.</span>}</div><p class="cover-story__empty">下一篇，从这里开始。</p></>
      )}
    </div>
  </section>

  <div class="reading-grid">
    <section aria-labelledby="recent-title">
      <div class="section-heading"><div><p class="eyebrow">THE READING INDEX</p><h2 id="recent-title">最近的文字</h2></div><a class="text-link" href={theme.urls.archive()}>全部文章 ↗</a></div>
      <div class="article-index">
        {posts.length > 0 ? posts.map((post, index) => <PostRow post={post} index={index + 1} language={theme.site.language} timezone={theme.site.blog?.timezone} />) : <p class="empty-note">这里还没有已发布的文章。好文字值得等待。</p>}
      </div>
    </section>
    <aside class="margin-notes" aria-label="页边手记">
      <div class="margin-heading"><span class="eyebrow">MARGINALIA</span><span aria-hidden="true">✳</span></div>
      <p class="editor-note">{theme.settings.editorNote.split('\n').map(line => <span>{line}</span>)}</p>
      <div class="editor-profile">
        {avatar && <img src={avatar} width="52" height="52" alt="" loading="lazy" />}
        <div><span class="eyebrow">此刊编辑</span><a href={theme.urls.page('about')}>{theme.site.profile.name || theme.site.title} ↗</a></div>
      </div>
      {(theme.site.profile.bio || theme.site.profile.signature) && <p class="margin-bio">{theme.site.profile.bio || theme.site.profile.signature}</p>}
      {tags.length > 0 && <div class="topic-index"><p class="eyebrow">常写的话题</p>{tags.map(tag => <a href={tag.url}><span>{tag.label}</span><span class="mono">{String(tag.count).padStart(2, '0')} ↗</span></a>)}</div>}
      <p class="margin-bottom mono">WRITE SOMETHING<br />WORTH KEEPING.</p>
    </aside>
  </div>
</Shell>
