---
import type { PageProps, StaticPageData } from '@mintfolio/core/astro';
import type { PressSettings } from '../settings';
import Shell from '../layouts/Shell.astro';
import Outline from '../components/Outline.astro';
import { formatDate, imageSrc, socialLabel, navigationKey } from '../utils/display';
type Props = PageProps<PressSettings, StaticPageData>;
const { theme, page } = Astro.props;
const avatar = imageSrc(page.profile.avatar);
const name = page.profile.name || theme.site.title;
const email = theme.site.contact.email;
// The contact email is listed once, even when a social entry repeats it as a mailto link.
const social = theme.site.social.filter(link => !(email && link.url.toLowerCase() === 'mailto:' + email.toLowerCase()));
const skills = theme.site.skills.filter(group => group.items.length > 0);
// Core titles the built-in about page for SEO ("关于我 - 站点名"); the heading uses the navigation label instead.
const heading = page.body ? page.title : theme.navigation.find(link => navigationKey(link.url, theme.site.url) === navigationKey(page.url, theme.site.url))?.label ?? '关于我';
---
<Shell theme={theme} page={page}>
  <header class="page-heading"><h1>{heading}</h1>{page.body && page.description && <p class="page-deck">{page.description}</p>}{page.updatedAt && <p class="post-meta">更新于 <time datetime={page.updatedAt}>{formatDate(page.updatedAt, theme.site.language, theme.site.blog?.timezone)}</time></p>}</header>
  {page.body ? (
    <div class="article-layout"><aside class="article-margin"><Outline headings={page.body.headings} /></aside><article class="press-prose article-main"><div set:html={page.body.html} /></article></div>
  ) : (
    <div class="about-layout">
      <div class="about-portrait">{avatar ? <img src={avatar} alt={name} width="700" height="840" /> : <div class="portrait-monogram" aria-hidden="true">{name.slice(0, 1)}</div>}</div>
      <div class="about-copy">
        <h2>{name}</h2>
        {(page.profile.bio || theme.site.description) && <p class="about-bio">{page.profile.bio || theme.site.description}</p>}
        {page.profile.signature && <blockquote>{page.profile.signature}</blockquote>}
        {page.profile.location && <p class="location-note"><span aria-hidden="true">◎</span> {page.profile.location}</p>}
        {(social.length > 0 || email) && <nav class="contact-links" aria-label="联系方式">{email && <a href={'mailto:' + email}>Email ↗</a>}{social.map(link => <a href={link.url}>{socialLabel(link.platform)} ↗</a>)}</nav>}
        {skills.length > 0 && <section class="about-skills" aria-labelledby="skills-title"><p class="eyebrow" id="skills-title">技能</p>{skills.map(group => <div><h3>{group.category}</h3><p>{group.items.map(item => item.name).join(' / ')}</p></div>)}</section>}
      </div>
      {theme.site.projects.length > 0 && <section class="about-projects" aria-labelledby="projects-title"><div class="section-heading"><h2 id="projects-title">项目</h2></div><div class="project-list">{theme.site.projects.map((project, index) => <article><span class="mono">{String(index + 1).padStart(2, '0')}</span><div><h3>{project.link ? <a href={project.link}>{project.title} ↗</a> : project.title}</h3><p>{project.description}</p>{project.tags.length > 0 && <p class="project-tags mono">{project.tags.join(' / ')}</p>}{project.repo && <a class="text-link" href={project.repo}>源代码 ↗</a>}</div></article>)}</div></section>}
    </div>
  )}
</Shell>
