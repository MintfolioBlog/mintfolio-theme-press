---
import type { PageProps, StaticPageData } from '@mintfolio/core/astro';
import type { PressSettings } from '../settings';
import Shell from '../layouts/Shell.astro';
import Outline from '../components/Outline.astro';
import { formatDate, imageSrc } from '../utils/display';
type Props = PageProps<PressSettings, StaticPageData>;
const { theme, page } = Astro.props;
const avatar = imageSrc(page.profile.avatar);
---
<Shell theme={theme} page={page}>
  <header class="page-heading"><p class="eyebrow">{page.body ? 'A PAGE FROM THE NOTEBOOK' : 'ABOUT THE EDITOR'} / 独立页面</p><h1>{page.body ? page.title : '写作的人。'}</h1>{page.body && page.description && <p class="page-deck">{page.description}</p>}{page.updatedAt && <p class="post-meta">更新于 <time datetime={page.updatedAt}>{formatDate(page.updatedAt, theme.site.language, theme.site.blog?.timezone)}</time></p>}</header>
  {page.body ? (
    <div class="article-layout"><aside class="article-margin"><Outline headings={page.body.headings} /></aside><article class="press-prose article-main"><div set:html={page.body.html} /></article></div>
  ) : (
    <div class="about-layout">
      <div class="about-portrait">{avatar ? <img src={avatar} alt={page.profile.name} width="700" height="840" /> : <div class="portrait-monogram" aria-hidden="true">{(page.profile.name || theme.site.title).slice(0, 1)}</div>}<span class="eyebrow">WORDS BY {page.profile.name || theme.site.title}</span></div>
      <div class="about-copy">
        <p class="eyebrow">你好，见字如面。</p><h2>{page.profile.name || theme.site.title}</h2>
        <p class="about-bio">{page.profile.bio || theme.site.description}</p>
        {page.profile.signature && <blockquote>{page.profile.signature}</blockquote>}
        {page.profile.location && <p class="location-note"><span aria-hidden="true">◎</span> {page.profile.location}</p>}
        {(theme.site.social.length > 0 || theme.site.contact.email) && <nav class="contact-links" aria-label="联系作者">{theme.site.contact.email && <a href={'mailto:' + theme.site.contact.email}>Email ↗</a>}{theme.site.social.map(link => <a href={link.url}>{link.platform} ↗</a>)}</nav>}
        {theme.site.skills.length > 0 && <section class="about-skills" aria-labelledby="skills-title"><p class="eyebrow" id="skills-title">持续练习的事</p>{theme.site.skills.map(group => <div><h3>{group.category}</h3><p>{group.items.map(item => item.name).join(' / ')}</p></div>)}</section>}
      </div>
      {theme.site.projects.length > 0 && <section class="about-projects" aria-labelledby="projects-title"><div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2 id="projects-title">把想法做出来</h2></div></div><div class="project-list">{theme.site.projects.map((project, index) => <article><span class="mono">{String(index + 1).padStart(2, '0')}</span><div><h3>{project.link ? <a href={project.link}>{project.title} ↗</a> : project.title}</h3><p>{project.description}</p>{project.tags.length > 0 && <p class="project-tags mono">{project.tags.join(' / ')}</p>}{project.repo && <a class="text-link" href={project.repo}>源代码 ↗</a>}</div></article>)}</div></section>}
    </div>
  )}
</Shell>
