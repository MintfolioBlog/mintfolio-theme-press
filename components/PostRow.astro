---
import type { PostSummary } from '@mintfolio/core/theme';
import Meta from './Meta.astro';
import { indexLabel } from '../utils/display';
interface Props { post: PostSummary; index: number; language?: string; timezone?: string; compact?: boolean; }
const { post, index, language, timezone, compact = false } = Astro.props;
---
<article class:list={['post-row', { 'post-row--compact': compact }]}>
  <span class="post-row__number" aria-hidden="true">{indexLabel(index)}</span>
  <div class="post-row__body">
    <div class="post-row__top"><a class="category-label" href={post.category.url}>{post.category.label}</a><Meta post={post} language={language} timezone={timezone} compact /></div>
    <h3 class="post-row__title"><a href={post.url}>{post.title}</a></h3>
    {!compact && post.description && <p class="post-row__summary">{post.description}</p>}
    {!compact && post.tags.length > 0 && <div class="post-row__tags">{post.tags.slice(0, 3).map(tag => <a href={tag.url}>#{tag.label}</a>)}</div>}
  </div>
  <a class="post-row__arrow" href={post.url} aria-label={'阅读：' + post.title}>↗</a>
</article>
