---
/** Original vector artwork; inherits the theme colors and needs no external asset. */
interface Props { label?: string; }
const { label = 'READ / WRITE / REPEAT' } = Astro.props;
const clipId = 'press-print-' + crypto.randomUUID();
---
<svg class="press-geometry" viewBox="0 0 640 660" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs><clipPath id={clipId}><rect x="0" y="0" width="640" height="660" /></clipPath></defs>
  <g clip-path={'url(#' + clipId + ')'}>
    <rect width="640" height="660" fill="var(--paper)" />
    <path d="M36 0V660M604 0V660M0 36H640M0 624H640" stroke="var(--ink)" stroke-width="1" opacity=".22" />
    <circle class="geometry-disc" cx="252" cy="242" r="197" fill="var(--accent)" />
    <path d="M444 73 575 302 313 302Z" fill="var(--ink)" />
    <g class="geometry-stripes" stroke="var(--ink)" stroke-width="22">
      <path d="m-30 444 373 216m-30-277 373 216m-30-277 373 216m-30-277 373 216m-30-277 373 216m-30-277 373 216m-30-277 373 216" />
    </g>
    <circle cx="330" cy="428" r="85" fill="var(--paper)" />
    <circle cx="330" cy="428" r="37" fill="var(--ink)" />
    <path d="M44 55h31m-15-15v30M566 598h31m-15-15v30" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="46" y="584" width="224" height="26" fill="var(--paper)" />
    <text x="54" y="602" fill="var(--ink)" font-family="monospace" font-size="13" letter-spacing="1.4">{label}</text>
  </g>
</svg>
