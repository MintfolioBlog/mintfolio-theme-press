---
import type { PostSummary } from '@mintfolio/core/theme';
import { formatDate } from '../utils/display';
interface Props { post: PostSummary; language?: string; timezone?: string; compact?: boolean; }
const { post, language, timezone, compact = false } = Astro.props;
---
<div class:list={['post-meta', { 'post-meta--compact': compact }]}>
  <time datetime={post.publishedAt}>{formatDate(post.publishedAt, language, timezone)}</time>
  {!compact && post.updatedAt && post.updatedAt !== post.publishedAt && <span>更新于 <time datetime={post.updatedAt}>{formatDate(post.updatedAt, language, timezone)}</time></span>}
  {post.readingMinutes !== undefined && <span>{post.readingMinutes} 分钟阅读</span>}
  {!compact && post.wordCount !== undefined && <span>{post.wordCount.toLocaleString(language)} 字</span>}
  {post.preview && <span class="status-label">本地预览</span>}
  {post.protected && <span class="status-label status-label--outline">密码文章</span>}
  {post.pinned && <span class="status-label status-label--outline">置顶</span>}
</div>
{!compact && !!post.authors?.length && (
  <p class="post-authors">作者
    {post.authors.map((author, index) => <>{index > 0 && ' / '}{author.url ? <a href={author.url}>{author.name}</a> : <span>{author.name}</span>}</>)}
  </p>
)}
